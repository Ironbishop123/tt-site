{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "tt-drops.schema.json",
 "$comment": "spec v0.7 §3. Calendar/DST/86400 s rules are enforced by docs/tools/drops_check.py (not expressible in JSON Schema).",
 "type": "object",
 "additionalProperties": false,
 "required": ["drops"],
 "properties": {
  "drops": {"type": "array", "items": {"$ref": "#/$defs/drop"}}
 },
 "$defs": {
  "instant_start": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T00:00:00-0[56]:00$"},
  "instant_end": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T23:59:59-0[56]:00$"},
  "price": {"type": ["number", "null"], "exclusiveMinimum": 0, "multipleOf": 0.01},
  "drop": {
   "type": "object",
   "additionalProperties": false,
   "$comment": "last_chance_* are optional and allowed only when features.json last_chance=true (enforced by drops_check.py, v0.7.4).",
   "required": ["id","artist_id","design_ids","starts_at","ends_at","live_price","vault_price","status_override","theme","size_upcharges"],
   "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]{1,40}$"},
    "artist_id": {"type": "string", "pattern": "^[a-z0-9-]{1,40}$"},
    "design_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9-]{1,40}$"}},
    "starts_at": {"$ref": "#/$defs/instant_start"},
    "ends_at": {"$ref": "#/$defs/instant_end"},
    "last_chance_starts_at": {"$ref": "#/$defs/instant_start"},
    "last_chance_ends_at": {"$ref": "#/$defs/instant_end"},
    "live_price": {"$ref": "#/$defs/price"},
    "last_chance_price": {"$ref": "#/$defs/price"},
    "vault_price": {"$ref": "#/$defs/price"},
    "status_override": {"enum": [null, "sold_out", "pulled"]},
    "theme": {"type": ["string", "null"], "pattern": "^[a-z0-9-]{1,40}$"},
    "size_upcharges": {
     "type": "object",
     "additionalProperties": false,
     "$comment": "USD added to the current state's price; same in every state (v0.7.1).",
     "required": ["2XL", "3XL", "4XL", "5XL"],
     "properties": {
      "2XL": {"type": "number", "minimum": 0, "multipleOf": 0.01},
      "3XL": {"type": "number", "minimum": 0, "multipleOf": 0.01},
      "4XL": {"type": "number", "minimum": 0, "multipleOf": 0.01},
      "5XL": {"type": "number", "minimum": 0, "multipleOf": 0.01}
     }
    }
   }
  }
 }
}
